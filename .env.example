# ─────────────────────────────────────────────────────────────────────────────
# Base de datos — MySQL (Aiven)
# ─────────────────────────────────────────────────────────────────────────────
# Pega aquí la cadena de conexión de Aiven, tal cual te la da el panel:
#
#   mysql://avnadmin:TU_PASSWORD@nombre-proyecto.a.aivencloud.com:12345/defaultdb
#
# Si la copias con "?ssl-mode=REQUIRED" al final no pasa nada: la app ignora
# los parámetros de la URL y configura el TLS por su cuenta.
DATABASE_URL=""

# TLS con Aiven (opcional pero recomendado).
# Aiven firma sus certificados con una autoridad propia, así que para poder
# *verificar* el certificado hay que darle ese CA. En el panel de Aiven:
# Overview → CA Certificate → Download (ca.pem).
#
# Acepta dos formas:
#   1. La ruta al archivo:  DATABASE_SSL_CA="./secrets/aiven-ca.pem"
#   2. El PEM completo en una sola línea, con \n entre renglones.
#
# Si lo dejas vacío la conexión igual va cifrada, pero sin verificar el
# certificado del servidor (y la app lo avisa en consola al arrancar).
DATABASE_SSL_CA=""

# ─────────────────────────────────────────────────────────────────────────────
# Sesiones
# ─────────────────────────────────────────────────────────────────────────────
# Con esto se firma la cookie de sesión. Si lo cambias, todas las sesiones
# abiertas se invalidan. Para generar uno nuevo: openssl rand -base64 32
SESSION_SECRET=""

# Los mapas del panel de técnico usan Leaflet + OpenStreetMap y geocoding con
# Photon/Nominatim. Todo gratis y sin API key — no hay nada que configurar aquí.

# ─────────────────────────────────────────────────────────────────────────────
# Groq (chat con IA) — usado por el widget público y el asistente interno
# ─────────────────────────────────────────────────────────────────────────────
# Se usa el SDK de OpenAI apuntando a la API de Groq (compatible con OpenAI).
# Consigue una clave gratis en https://console.groq.com/keys
GROQ_API_KEY=""

# Modelo a usar (opcional). Vacío = valor por defecto razonable para chat
# con tool-calling (openai/gpt-oss-120b). Groq retira modelos con el tiempo:
# si deja de funcionar, revisa los modelos vigentes en
# https://console.groq.com/docs/models
GROQ_MODEL=""
