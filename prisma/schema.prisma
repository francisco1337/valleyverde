// Esquema de Valley Verde Operations.
//
// Se construye por módulos. Hoy están identidad (usuarios y su rol) y la
// cartera (clientes). Lo que sigue — ubicaciones, servicios, asignaciones,
// eventos y evidencias — está diseñado en valleyverde.dbml, en la raíz.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  // La cadena de conexión no va aquí: Prisma 7 la lee de prisma7.config.ts.
  provider = "mysql"
}

/// Los tres roles del sistema. El login es uno solo; el rol decide a qué
/// panel aterriza cada persona y qué puede abrir.
enum Rol {
  ADMINISTRADOR
  OFICINA
  TECNICO
}

model Usuario {
  // La identidad la genera el dominio (RepositorioDeUsuarios.siguienteId),
  // no la base: así un Usuario ya es un Usuario antes de tocar MySQL.
  id String @id

  /// Con lo que la persona inicia sesión. Se guarda y se compara en
  /// MAYÚSCULAS para que "tecnico" y "TECNICO" sean la misma cuenta.
  usuario String @unique

  /// Nombre para mostrar en la interfaz.
  nombre String

  /// Hash bcrypt. Aquí nunca se guarda una contraseña en texto plano.
  passwordHash String

  rol Rol

  /// Dar de baja a alguien sin borrar su historial.
  activo Boolean @default(true)

  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  @@map("usuarios")
}

/// Una empresa a la que Valley Verde le presta servicio: la administradora del
/// centro comercial, la mesa directiva del fraccionamiento, el dueño del
/// edificio. De aquí van a colgar las ubicaciones.
model Cliente {
  // Igual que Usuario: la identidad la genera el dominio, no la base.
  id String @id

  /// Razón social o nombre comercial. Es como lo busca la oficina.
  nombre String

  /// La persona con la que se trata. Opcional: a veces se da de alta la
  /// empresa antes de saber quién va a contestar el teléfono.
  contacto String?

  telefono String?
  correo   String?
  notas    String? @db.Text

  /// Un cliente con historial no se borra, se desactiva.
  activo Boolean @default(true)

  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  // La lista de la oficina es "los activos, por nombre". Este índice la cubre
  // entera: filtra y ordena sin pasar por un filesort.
  @@index([activo, nombre])
  @@map("clientes")
}
